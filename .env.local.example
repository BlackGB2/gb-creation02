# Sanity CMS Configuration
# Get your Project ID at: https://www.sanity.io/manage
# If you leave these blank, the portfolio automatically uses rich built-in mock data!
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-03-01

# Sanity API Token (Needed for running the one-command seed script: npm run seed)
# Create a token with 'Editor' permissions in your Sanity Project Settings -> API -> Tokens
SANITY_API_TOKEN=
